        <div class="brand-sub">Investment Platform</div>
        <div class="brand-rule"></div>
      </div>
      <nav class="nav-section">
        <div class="nav-label">Main Menu</div>
        <a class="nav-item" href="dashboard.html"
          ><svg
            class="nav-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
