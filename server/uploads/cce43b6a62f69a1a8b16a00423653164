          >
            <circle cx="12" cy="8" r="7" />
            <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88" /></svg
          ><span class="nav-text">Ventures</span></a
        >
      </nav>
      <div class="sidebar-footer">
        <div class="user-row">
          <div class="user-avatar">A</div>
          <div class="user-info">
            <div class="user-name">Armaghan Ali</div>
            <div class="user-role">Entrepreneur</div>
          </div>
        </div>
        <button class="logout-btn">Sign Out</button>
      </div>
    </aside>

    <main class="workspace">
      <header class="topbar">
        <div>
          <div class="topbar-eyebrow">Dashboard · Documents</div>
          <div class="topbar-title">Document <em>Vault</em></div>
        </div>
        <div class="topbar-right">
          <span class="topbar-date" id="cd"></span>
          <button class="gold-action-btn">
            <svg
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="12" y1="5" x2="12" y2="19" />
              <line x1="5" y1="12" x2="19" y2="12" /></svg
            >Upload
          </button>
        </div>
      </header>
      <div class="content">
        <!-- storage -->
        <div class="storage-bar-wrap anim d1">
          <span class="storage-label">Storage</span>
          <div class="storage-bar"><div class="storage-fill"></div></div>
          <span class="storage-text">3.8 GB of 10 GB used</span>
        </div>
        <form id="doc-upload-form">
          <label for="fileInput">Select a document to upload</label>
          <input type="file" id="fileInput" required />
          <button type="submit">Upload Document</button>
        </form>
        <!-- toolbar -->
        <div class="toolbar anim d2">
          <div class="search-wrap">
            <svg viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <input
              class="search-input"
              type="text"
              placeholder="Search documents…"
            />
          </div>
          <button class="filter-btn active">All</button>
          <button class="filter-btn">PDF</button>
          <button class="filter-btn">Spreadsheet</button>
          <button class="filter-btn">Word</button>
        </div>
        <!-- folders -->
        <div class="folder-row anim d3">
          <div class="folder active">
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"
              /></svg
            >All Files<span class="folder-count">12</span>
          </div>
          <div class="folder">
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"
              /></svg
            >Botanica Fund<span class="folder-count">4</span>
          </div>
          <div class="folder">
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"
              /></svg
            >Green Valley<span class="folder-count">3</span>
          </div>
          <div class="folder">
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"
              /></svg
            >Alpine Co.<span class="folder-count">3</span>
          </div>
          <div class="folder">
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="11" width="18" height="11" rx="2" />
              <path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg
            >Legal<span class="folder-count">2</span>
          </div>
        </div>
        <!-- table -->
        <table class="doc-table">
          <thead>
            <tr>
              <th>Document</th>
              <th>Project</th>
              <th>Last Updated</th>
              <th>Size</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <tr class="anim d4">
              <td>
                <div class="doc-name-cell">
                  <div class="doc-type-badge dt-pdf">PDF</div>
                  <div>
                    <div class="doc-name-text">
                      Botanica Fund IV — Term Sheet
                    </div>
                    <div class="doc-name-sub">term-sheet-v3-final.pdf</div>
                  </div>
                </div>
              </td>
              <td class="doc-project">Botanica Fund</td>
              <td class="doc-date">2 hours ago</td>
              <td class="doc-size">1.2 MB</td>
              <td><span class="doc-status ds-review">In Review</span></td>
              <td>
                <div class="doc-action">
                  <button class="btn-sm btn-sm-dark">View</button
                  ><button class="btn-sm btn-sm-ghost">Sign</button>
                </div>
              </td>
            </tr>
            <tr class="anim d5">
              <td>
                <div class="doc-name-cell">
                  <div class="doc-type-badge dt-xls">XLS</div>
                  <div>
                    <div class="doc-name-text">
                      Q2 Financial Projections 2025
                    </div>
                    <div class="doc-name-sub">q2-projections-2025.xlsx</div>
                  </div>
                </div>
              </td>
              <td class="doc-project">All Projects</td>
              <td class="doc-date">Yesterday</td>
              <td class="doc-size">840 KB</td>
              <td><span class="doc-status ds-signed">Signed</span></td>
              <td>
                <div class="doc-action">
                  <button class="btn-sm btn-sm-dark">View</button
                  ><button class="btn-sm btn-sm-ghost">Export</button>
                </div>
              </td>
            </tr>
            <tr class="anim d6">
              <td>
                <div class="doc-name-cell">
                  <div class="doc-type-badge dt-doc">DOC</div>
                  <div>
                    <div class="doc-name-text">
                      Partnership Agreement — Alpine
                    </div>
                    <div class="doc-name-sub">alpine-partnership-v2.docx</div>
                  </div>
                </div>
              </td>
              <td class="doc-project">Alpine Co.</td>
              <td class="doc-date">3 days ago</td>
              <td class="doc-size">320 KB</td>
              <td><span class="doc-status ds-draft">Draft</span></td>
              <td>
                <div class="doc-action">
                  <button class="btn-sm btn-sm-dark">View</button
                  ><button class="btn-sm btn-sm-ghost">Edit</button>
                </div>
              </td>
            </tr>
            <tr class="anim d7">
              <td>
                <div class="doc-name-cell">
                  <div class="doc-type-badge dt-pdf">PDF</div>
                  <div>
                    <div class="doc-name-text">
                      Investor Deck — Green Valley v3
                    </div>
                    <div class="doc-name-sub">gv-investor-deck-v3.pdf</div>
                  </div>
                </div>
              </td>
              <td class="doc-project">Green Valley</td>
              <td class="doc-date">Last week</td>
              <td class="doc-size">5.4 MB</td>
              <td><span class="doc-status ds-signed">Signed</span></td>
              <td>
                <div class="doc-action">
                  <button class="btn-sm btn-sm-dark">View</button
                  ><button class="btn-sm btn-sm-ghost">Share</button>
                </div>
              </td>
            </tr>
            <tr class="anim d8">
              <td>
                <div class="doc-name-cell">
                  <div class="doc-type-badge dt-ppt">PPT</div>
                  <div>
                    <div class="doc-name-text">
                      Botanica Pitch Deck — Series A
                    </div>
                    <div class="doc-name-sub">botanica-series-a.pptx</div>
                  </div>
                </div>
              </td>
              <td class="doc-project">Botanica Fund</td>
              <td class="doc-date">May 18</td>
              <td class="doc-size">12.1 MB</td>
              <td><span class="doc-status ds-review">In Review</span></td>
              <td>
                <div class="doc-action">
                  <button class="btn-sm btn-sm-dark">View</button
                  ><button class="btn-sm btn-sm-ghost">Comment</button>
                </div>
              </td>
            </tr>
            <tr class="anim d9">
              <td>
                <div class="doc-name-cell">
                  <div class="doc-type-badge dt-xls">XLS</div>
                  <div>
                    <div class="doc-name-text">
                      Cap Table — Alpine Herbal Co.
                    </div>
                    <div class="doc-name-sub">alpine-cap-table.xlsx</div>
                  </div>
                </div>
              </td>
              <td class="doc-project">Alpine Co.</td>
              <td class="doc-date">May 15</td>
              <td class="doc-size">290 KB</td>
              <td><span class="doc-status ds-signed">Signed</span></td>
              <td>
                <div class="doc-action">
                  <button class="btn-sm btn-sm-dark">View</button
                  ><button class="btn-sm btn-sm-ghost">Export</button>
                </div>
              </td>
            </tr>
            <tr class="anim d10">
              <td>
                <div class="doc-name-cell">
                  <div class="doc-type-badge dt-pdf">PDF</div>
                  <div>
                    <div class="doc-name-text">NDA — Green Valley Partners</div>
                    <div class="doc-name-sub">gvp-nda-2025.pdf</div>
                  </div>
                </div>
              </td>
              <td class="doc-project">Green Valley</td>
              <td class="doc-date">May 12</td>
              <td class="doc-size">180 KB</td>
              <td><span class="doc-status ds-signed">Signed</span></td>
              <td>
                <div class="doc-action">
                  <button class="btn-sm btn-sm-dark">View</button
                  ><button class="btn-sm btn-sm-ghost">Archive</button>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </main>
    <script src="assets/js/common.js">
        // Run this immediately when a page loads
      if (!localStorage.getItem("token")) {
          window.location.href = "login.html"; // Adjust path as needed
      }
        document.getElementById('cd').textContent=new Date().toLocaleDateString('en-US',{weekday:'long',month:'long',day:'numeric',year:'numeric'});
        document.querySelectorAll('.filter-btn').forEach(b=>b.addEventListener('click',function(){document.querySelectorAll('.filter-btn').forEach(x=>x.classList.remove('active'));this.classList.add('active');}));
        document.querySelectorAll('.folder').forEach(f=>f.addEventListener('click',function(){document.querySelectorAll('.folder').forEach(x=>x.classList.remove('active'));this.classList.add('active');}));
    </script>
  </body>
</html>
