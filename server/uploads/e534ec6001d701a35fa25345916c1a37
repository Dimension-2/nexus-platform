    <div class="nav-label" style="margin-top:1rem;">Portfolio</div>
    <a class="nav-item" href="analytics.html"><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg><span class="nav-text">Analytics</span></a>
    <a class="nav-item" href="ventures.html"><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg><span class="nav-text">Ventures</span></a>
  </nav>
  <div class="sidebar-footer"><div class="user-row"><div class="user-avatar">A</div><div class="user-info"><div class="user-name">Armaghan Ali</div><div class="user-role">Entrepreneur</div></div></div><button class="logout-btn">Sign Out</button></div>
</aside>

<main class="workspace">
  <header class="topbar">
    <div><div class="topbar-eyebrow">Dashboard · Payments</div><div class="topbar-title">Financial <em>Overview</em></div></div>
    <div class="topbar-right">
      <span class="topbar-date" id="cd"></span>
      <button class="gold-action-btn"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>New Payment</button>
    </div>
  </header>
  <div class="content">
    <!-- balance row -->
    <div class="balance-row">
      <div class="bal-card main-card anim d1">
        <div class="bal-label">Total Balance</div>
        <div class="bal-amount">$48,250</div>
        <div class="bal-sub">Across all projects · Updated now</div>
      </div>
      <div class="bal-card anim d2"><div class="bal-label">Received (MTD)</div><div class="bal-amount">$12,400</div><div class="bal-trend up-green">↑ 18% vs last month</div></div>
      <div class="bal-card anim d3"><div class="bal-label">Disbursed (MTD)</div><div class="bal-amount">$6,850</div><div class="bal-trend neutral">↔ Stable</div></div>
      <div class="bal-card anim d4"><div class="bal-label">Pending</div><div class="bal-amount">$3,200</div><div class="bal-trend down-red">2 awaiting approval</div></div>
    </div>

    <!-- chart + donut -->
    <div class="chart-section">
      <div class="chart-card anim d5">
        <div class="chart-head">
          <span class="chart-title">Cash Flow — May 2026</span>
          <div class="chart-legend">
            <div class="legend-item"><div class="legend-dot" style="background:var(--forest)"></div>Received</div>
            <div class="legend-item"><div class="legend-dot" style="background:var(--gold)"></div>Disbursed</div>
          </div>
        </div>
        <svg class="bar-chart" viewBox="0 0 520 140" preserveAspectRatio="none">
          <!-- grid lines -->
          <line x1="0" y1="0" x2="520" y2="0" stroke="var(--border-lt)" stroke-width="1"/>
          <line x1="0" y1="46" x2="520" y2="46" stroke="var(--border-lt)" stroke-width="1"/>
          <line x1="0" y1="92" x2="520" y2="92" stroke="var(--border-lt)" stroke-width="1"/>
          <line x1="0" y1="138" x2="520" y2="138" stroke="var(--border)" stroke-width="1"/>
          <!-- bars (received) -->
          <rect x="10"  y="60" width="22" height="78" fill="var(--forest)" opacity=".8"/>
          <rect x="62"  y="40" width="22" height="98" fill="var(--forest)" opacity=".8"/>
          <rect x="114" y="30" width="22" height="108" fill="var(--forest)" opacity=".8"/>
          <rect x="166" y="50" width="22" height="88" fill="var(--forest)" opacity=".8"/>
          <rect x="218" y="20" width="22" height="118" fill="var(--forest)" opacity=".8"/>
          <rect x="270" y="45" width="22" height="93" fill="var(--forest)" opacity=".8"/>
          <rect x="322" y="35" width="22" height="103" fill="var(--forest)" opacity=".8"/>
          <!-- bars (disbursed) -->
          <rect x="34"  y="80" width="22" height="58" fill="var(--gold)" opacity=".7"/>
          <rect x="86"  y="70" width="22" height="68" fill="var(--gold)" opacity=".7"/>
          <rect x="138" y="60" width="22" height="78" fill="var(--gold)" opacity=".7"/>
          <rect x="190" y="75" width="22" height="63" fill="var(--gold)" opacity=".7"/>
          <rect x="242" y="50" width="22" height="88" fill="var(--gold)" opacity=".7"/>
          <rect x="294" y="65" width="22" height="73" fill="var(--gold)" opacity=".7"/>
          <rect x="346" y="55" width="22" height="83" fill="var(--gold)" opacity=".7"/>
        </svg>
      </div>
      <div class="chart-card anim d6">
        <div class="chart-head"><span class="chart-title">Allocation</span></div>
        <div class="donut-wrap">
          <svg width="110" height="110" viewBox="0 0 36 36">
            <circle cx="18" cy="18" r="15.9" fill="none" stroke="var(--border-lt)" stroke-width="3"/>
            <circle cx="18" cy="18" r="15.9" fill="none" stroke="var(--forest)" stroke-width="3" stroke-dasharray="48 52" stroke-dashoffset="25" stroke-linecap="round"/>
            <circle cx="18" cy="18" r="15.9" fill="none" stroke="var(--gold)" stroke-width="3" stroke-dasharray="30 70" stroke-dashoffset="-23" stroke-linecap="round"/>
            <circle cx="18" cy="18" r="15.9" fill="none" stroke="#4a90a4" stroke-width="3" stroke-dasharray="22 78" stroke-dashoffset="-53" stroke-linecap="round"/>
            <text x="18" y="21" text-anchor="middle" fill="var(--text-dark)" font-size="6" font-family="Cormorant Garamond,serif" font-weight="600">3</text>
          </svg>
          <div class="donut-label">Active Projects</div>
          <div style="display:flex;flex-direction:column;gap:.4rem;width:100%">
            <div style="display:flex;align-items:center;justify-content:space-between;font-size:.56rem;"><span style="display:flex;align-items:center;gap:.4rem;color:var(--text-mid);"><span style="width:8px;height:8px;background:var(--forest);display:inline-block;"></span>Botanica</span><span style="color:var(--text-dark);font-weight:600;">48%</span></div>
            <div style="display:flex;align-items:center;justify-content:space-between;font-size:.56rem;"><span style="display:flex;align-items:center;gap:.4rem;color:var(--text-mid);"><span style="width:8px;height:8px;background:var(--gold);display:inline-block;"></span>Alpine</span><span style="color:var(--text-dark);font-weight:600;">30%</span></div>
            <div style="display:flex;align-items:center;justify-content:space-between;font-size:.56rem;"><span style="display:flex;align-items:center;gap:.4rem;color:var(--text-mid);"><span style="width:8px;height:8px;background:#4a90a4;display:inline-block;"></span>Green Valley</span><span style="color:var(--text-dark);font-weight:600;">22%</span></div>
          </div>
        </div>
      </div>
    </div>
<form id="payment-form">
    <div id="card-element"></div> <button type="submit">Pay Now</button>
</form>
    <!-- transactions -->
    <div style="font-size:.58rem;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--text-lt);margin-bottom:1rem;" class="anim d7">Recent Transactions</div>
    <table class="txn-table">
      <thead><tr><th>Transaction</th><th>Project</th><th>Date</th><th>Amount</th><th>Status</th></tr></thead>
      <tbody>
        <tr class="anim d7"><td><div class="txn-name-cell"><div class="txn-icon ti-in"><svg viewBox="0 0 24 24" stroke="var(--forest-xl)"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg></div><div><div class="txn-name">Investment Received</div><div class="txn-sub">From Khalid Raza · Wire Transfer</div></div></div></td><td class="txn-project">Botanica Fund</td><td class="txn-date">Today, 9:14 AM</td><td class="txn-amt amt-in">+$8,000</td><td><span class="txn-status ts-done">Completed</span></td></tr>
        <tr class="anim d8"><td><div class="txn-name-cell"><div class="txn-icon ti-out"><svg viewBox="0 0 24 24" stroke="var(--gold-dk)"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg></div><div><div class="txn-name">Legal Fees Disbursed</div><div class="txn-sub">To Counsel Group · Bank Transfer</div></div></div></td><td class="txn-project">Green Valley</td><td class="txn-date">Yesterday</td><td class="txn-amt amt-out">−$1,200</td><td><span class="txn-status ts-done">Completed</span></td></tr>
        <tr class="anim d9"><td><div class="txn-name-cell"><div class="txn-icon ti-in"><svg viewBox="0 0 24 24" stroke="var(--forest-xl)"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg></div><div><div class="txn-name">Milestone Payment</div><div class="txn-sub">From James Rho · SWIFT</div></div></div></td><td class="txn-project">Alpine Co.</td><td class="txn-date">May 20</td><td class="txn-amt amt-in">+$4,400</td><td><span class="txn-status ts-done">Completed</span></td></tr>
        <tr class="anim d10"><td><div class="txn-name-cell"><div class="txn-icon ti-fee"><svg viewBox="0 0 24 24" stroke="var(--text-mid)"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></div><div><div class="txn-name">Platform Service Fee</div><div class="txn-sub">Nexus Monthly Subscription</div></div></div></td><td class="txn-project">Platform</td><td class="txn-date">May 18</td><td class="txn-amt amt-fee">−$149</td><td><span class="txn-status ts-pending">Pending</span></td></tr>
      </tbody>
    </table>
  </div>
</main>
<script src="assets/js/common.js"> 
